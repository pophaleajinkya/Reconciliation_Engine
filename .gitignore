# ── Secrets ─────────────────────────────────────────────────────────
.env
.env.*
!.env.example
.streamlit/secrets.toml

# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.venv/
venv/
.tox/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── OS / editor ─────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/

# ── Reconciliation outputs (regenerated per run) ────────────────────
# The whole output/ tree is generated by `python -m reconcile <case>`.
# Keeping it out of git keeps the repo small and avoids merge churn on
# stamp-crop PNGs and per-run JSON.
app/output/
output/

# ── Surya / model weights cache ─────────────────────────────────────
*.safetensors
*.bin
.surya/
~/.cache/huggingface/

# ── Misc ────────────────────────────────────────────────────────────
*.log
*.tmp

# ── Confidential challenge materials (do not redistribute) ──────────
# The Curta take-home case bundles and the original case PDF live
# locally for testing, but must not be pushed to the public repo.
Curta Take Home Challenge/

# ── Local scratch directories not part of the canonical repo ────────
app2/
