# ────────────────────────────────────────────────────────────────────
# Reconciliation Engine — example env (copy to .env and fill in)
# ────────────────────────────────────────────────────────────────────
# Choose provider: `openrouter` (default, no daily cap) or `groq`.
LLM_PROVIDER=openrouter

# ── OpenRouter ──────────────────────────────────────────────────────
# Get a key at https://openrouter.ai/keys. Keys start with `sk-or-v1-...`.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Groq (optional fallback) ────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Model overrides (optional) ──────────────────────────────────────
# Per-provider defaults are applied automatically. Uncomment to override.
# LLM_TEXT_MODEL=meta-llama/llama-3.3-70b-instruct
# LLM_VISION_MODEL=meta-llama/llama-4-scout
